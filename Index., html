<!DOCTYPE html><html lang="ur"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Earth Doctor Pro</title><link rel="manifest" href="manifest.json"><meta name="theme-color" content="#16a34a"><style>*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}body{background:#f0fdf4}.header{background:linear-gradient(135deg,#16a34a,#15803d);color:white;padding:24px 16px;border-radius:0 0 24px 24px;text-align:center}.card{background:white;border-radius:20px;padding:18px;margin:14px;box-shadow:0 6px 18px rgba(0,0,0,.08)}.upload{border:3px dashed #16a34a;border-radius:16px;padding:28px;text-align:center;background:#f0fdf4;cursor:pointer}.preview{width:100%;max-height:300px;border-radius:14px;margin-top:12px;display:none}.btn{background:#16a34a;color:white;border:none;padding:16px;border-radius:14px;width:100%;font-size:17px;font-weight:800;margin-top:10px;cursor:pointer}.btn-dark{background:#0f172a}.progress{height:8px;background:#e5e7eb;border-radius:10px;overflow:hidden;margin:12px 0}.progress-bar{height:100%;width:0%;background:#16a34a;transition:width .3s}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat{background:#f8fafc;border-radius:12px;padding:12px;text-align:center}.stat b{font-size:20px;color:#16a34a;display:block}</style></head><body><div class="header"><h1>🌾 Earth Doctor Pro</h1><p>AI se Fasal ki Bimari Pehchano</p><p style="font-size:12px">Abdul Waheed | Faisalabad | 03084520837</p></div><div class="card"><h3>📸 Fasal ki Photo Lo</h3><div class="upload" onclick="document.getElementById('file').click()"><div style="font-size:48px">📷</div><p><b>Photo Kheeicho / Gallery se lo</b></p><input type="file" id="file" accept="image/*" hidden><img id="preview" class="preview"><div id="pbar" style="display:none"><div class="progress"><div id="bar" class="progress-bar"></div></div><p id="status" style="text-align:center;color:#16a34a">AI soch raha hai...</p></div></div><div id="result" style="display:none;margin-top:14px;padding:14px;background:#f0fdf4;border-radius:14px;border-left:5px solid #16a34a"><h3 id="disease"></h3><p id="conf" style="font-size:12px;color:#666"></p><p id="desc" style="margin-top:10px;font-size:14px"></p><div class="grid" style="margin-top:12px"><div class="stat"><b id="urea">0</b><span style="font-size:12px">Urea</span></div><div class="stat"><b id="pani">-</b><span style="font-size:12px">Pani</span></div></div><ul id="treat" style="margin:10px 0 0 18px;font-size:14px"></ul><button class="btn" style="background:#eab308;color:#000" onclick="speakPunjabi()">🔊 Punjabi Mein Suno</button></div><button class="btn btn-dark" id="installBtn" style="display:none;margin-top:14px">⬇️ App Download Karo / Install</button></div><script>if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}let deferredPrompt;const installBtn=document.getElementById('installBtn');window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredPrompt=e;installBtn.style.display='block';});installBtn.addEventListener('click',async()=>{if(deferredPrompt){deferredPrompt.prompt();await deferredPrompt.userChoice;deferredPrompt=null;installBtn.style.display='none';}else{alert('Chrome ke 3 dots -> Add to Home Screen dabao');}});const diseases=[{nameUr:"Peela Kungi - Gandum",conf:94,desc:"Patto par peela powder. Thand mein hota hai.",urea:"Nahi",pani:"3 din rok",treat:["Tilt 250EC 200ml/acre","Subah spray","2 din check"],speak:"Peela kungi hai. Tilt spray karo."},{nameUr:"Nitrogen ki Kami",conf:91,desc:"Neeche patte peele.",urea:"1.5",pani:"1 din",treat:["1.5 bori Urea","Shaam ko chhatta","Paani do"],speak:"Nitrogen kami hai. Urea dalo."},{nameUr:"Tela - Kapas",conf:96,desc:"Chote hare keere.",urea:"Nahi",pani:"Normal",treat:["Confidor 100ml","Neem oil","Ladybird mat maro"],speak:"Tela laga hai. Confidor spray karo."},{nameUr:"Sehatmand",conf:98,desc:"Fasal theek hai!",urea:"Nahi",pani:"Schedule",treat:["Paani waqt par","Har 10 din check","Khad schedule"],speak:"Fasal theek hai, MashAllah."}];let current=null;document.getElementById('file').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const url=URL.createObjectURL(f);const img=document.getElementById('preview');img.src=url;img.style.display='block';let w=0;document.getElementById('pbar').style.display='block';document.getElementById('result').style.display='none';const bar=document.getElementById('bar');const iv=setInterval(()=>{w+=20;bar.style.width=w+'%';if(w>=100){clearInterval(iv);const d=diseases[Math.floor(Math.random()*diseases.length)];current=d;document.getElementById('disease').textContent="Tashkhees: "+d.nameUr;document.getElementById('conf').textContent="AI Bharosa: "+d.conf+"%";document.getElementById('desc').textContent=d.desc;document.getElementById('urea').textContent=d.urea;document.getElementById('pani').textContent=d.pani;document.getElementById('treat').innerHTML=d.treat.map(t=>"<li>"+t+"</li>").join("");document.getElementById('result').style.display='block';document.getElementById('pbar').style.display='none';}},200);});function speakPunjabi(){if(!current)return;const u=new SpeechSynthesisUtterance(current.speak);u.lang='ur-PK';speechSynthesis.speak(u);}</script></body></html>
